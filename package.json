{
  "name": "miai-agent-marketplace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @miai/web dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm -r --filter './packages/*' build",
    "build:web": "pnpm build:packages && pnpm --filter @miai/web build",
    "start:web": "sh scripts/start-web.sh",
    "import:catalog": "node scripts/import-catalog.mjs",
    "generate:packs": "node scripts/generate-market-packs.mjs",
    "merge:za-africa": "node scripts/merge-za-into-africa.mjs",
    "polish:catalog": "node scripts/polish-catalog.mjs --force",
    "generate:presets": "node scripts/generate-presets.mjs",
    "catalog:ready": "node scripts/catalog-readiness.mjs",
    "catalogue:ship": "pnpm polish:catalog && pnpm generate:presets && pnpm build:packages && pnpm catalog:ready",
    "typecheck": "pnpm -r typecheck",
    "eval:smoke": "pnpm build:packages && node scripts/eval-smoke.mjs",
    "eval:suite": "pnpm build:packages && node scripts/eval-suite.mjs",
    "eval:suite:static": "pnpm build:packages && node scripts/eval-suite.mjs --static-only",
    "fix:evals": "node scripts/fix-catalogue-evals.mjs",
    "heal:evals": "node scripts/heal-eval-failures.mjs",
    "eval:full": "pnpm fix:evals && pnpm build:packages && node scripts/eval-suite.mjs && node scripts/heal-eval-failures.mjs && node scripts/eval-suite.mjs",
    "demo:phase1": "node scripts/phase1-demo.mjs",
    "pdf:branded": "node docs/branded-pdfs/generate.mjs",
    "test:wallet": "pnpm --filter @miai/wallet-adapter test",
    "validate:azure": "bash scripts/validate-azure.sh",
    "smoke:cutover": "node scripts/cutover-smoke.mjs",
    "demo:app": "pnpm --dir apps/mobile-shell start"
  }
}
