# MyInstantAI integration (mock until live credentials)
# See docs/MIGRATION_P0.md
MIAI_AUTH_MODE=mock
MIAI_WALLET_MODE=mock
MIAI_MODEL_MODE=mock
# mock | openai | anthropic | gateway
MIAI_WALLET_API_URL=
MIAI_WALLET_API_KEY=
MIAI_MODEL_GATEWAY_URL=
MIAI_MODEL_GATEWAY_KEY=
# ANTHROPIC_API_KEY=              # when MIAI_MODEL_MODE=anthropic
# OPENAI_API_KEY=                 # when MIAI_MODEL_MODE=openai
MIAI_OIDC_ISSUER=
MIAI_OIDC_AUDIENCE=
MIAI_OIDC_JWKS_URL=
# DATABASE_URL=postgresql://...       # Azure/Railway Postgres; else file fallback
# MIAI_DATABASE_URL=postgresql://...  # alias for DATABASE_URL
# RENTAL_STORE_PATH=/data/rentals.json
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# Public URL used for OAuth redirect_uri
# Local: http://localhost:3001
# Railway: https://YOUR_SERVICE.up.railway.app
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Staging with mock rails under NODE_ENV=production (BOTH flags required):
# ALLOW_MOCK_RAILS=1
# I_UNDERSTAND_MOCK_RAILS_IN_PROD=1
# Bare embed CORS * (BOTH flags required — prefer an origin allowlist):
# ALLOW_EMBED_ORIGIN_STAR=1
# I_UNDERSTAND_EMBED_ORIGIN_STAR=1
# WEBHOOK_SINK_SECRET=
# MCP_SINK_TOKEN=
# Optional: verify Postgres TLS when CA is mounted
# PG_SSL_REJECT_UNAUTHORIZED=1
# PGSSLROOTCERT=/path/to/ca.pem

# Secrets — long random values in staging/production
OAUTH_TOKEN_SECRET=replace-with-long-random-string
OAUTH_STATE_SECRET=
EMBED_KEY_SECRET=
# Embed CORS: comma-separated origins. Bare * needs ALLOW_EMBED_ORIGIN_STAR=1 in production.
EMBED_ALLOWED_ORIGINS=http://localhost:3000
OAUTH_TOKEN_STORE_PATH=
KNOWLEDGE_STORE_PATH=
CATALOG_DIR=

# Optional Upstash Redis REST — shared rate limits + chat sessions when running multiple replicas.
# REDIS_URL=                      # reserved alias; unused in v1
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Google (Calendar + Gmail)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft (M365 Calendar, Teams, Email)
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Slack
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_DEFAULT_CHANNEL=

# Shopify / HubSpot / Xero / QuickBooks / Calendly / Zendesk
SHOPIFY_OAUTH_CLIENT_ID=
SHOPIFY_OAUTH_CLIENT_SECRET=
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
XERO_OAUTH_CLIENT_ID=
XERO_OAUTH_CLIENT_SECRET=
QUICKBOOKS_OAUTH_CLIENT_ID=
QUICKBOOKS_OAUTH_CLIENT_SECRET=
QUICKBOOKS_ENV=sandbox
CALENDLY_OAUTH_CLIENT_ID=
CALENDLY_OAUTH_CLIENT_SECRET=
ZENDESK_OAUTH_CLIENT_ID=
ZENDESK_OAUTH_CLIENT_SECRET=

TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=
HANDOFF_EMAIL_TO=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
STRIPE_SECRET_KEY=
