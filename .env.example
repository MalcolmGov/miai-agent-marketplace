# MyInstantAI integration (mock until live credentials)
# See docs/MIGRATION_P0.md
MIAI_AUTH_MODE=mock
MIAI_WALLET_MODE=mock
MIAI_MODEL_MODE=mock
# mock | openai | azure | anthropic | gateway
MIAI_WALLET_API_URL=
MIAI_WALLET_API_KEY=
MIAI_MODEL_GATEWAY_URL=
MIAI_MODEL_GATEWAY_KEY=
# ANTHROPIC_API_KEY=              # when MIAI_MODEL_MODE=anthropic
# OPENAI_API_KEY=                 # when MIAI_MODEL_MODE=openai (also auto-enables hybrid semantic retrieval)
# --- Azure OpenAI (MIAI_MODEL_MODE=azure) — the Azure infra migration target ---
# AZURE_OPENAI_ENDPOINT=          # https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=           # resource api-key
# AZURE_OPENAI_DEPLOYMENT=        # default deployment name (e.g. gpt-4o-mini)
# AZURE_OPENAI_DEPLOYMENT_LARGE=  # optional deployment for higher tiers (e.g. gpt-4o)
# AZURE_OPENAI_API_VERSION=       # default 2024-10-21
# RUNTIME_SEMANTIC_RETRIEVAL=auto # auto|1|0|local — hybrid RAG; auto uses OpenAI embeddings when key set
# EMBEDDING_API_KEY=              # optional override (else OPENAI_API_KEY)
# EMBEDDING_BASE_URL=             # OpenAI-compatible /v1 (default api.openai.com/v1)
# EMBEDDING_MODEL=text-embedding-3-small
# B2B Agents auth (separate from consumer) — docs/B2B_ONBOARDING.md
# MIAI_AGENTS_AUTH_URL=https://app.myinstantai.com/auth
# NEXT_PUBLIC_MIAI_AGENTS_AUTH_URL=https://app.myinstantai.com/auth
# NEXT_PUBLIC_MIAI_CONSUMER_APP_URL=https://myinstantai.com
MIAI_OIDC_ISSUER=
MIAI_OIDC_AUDIENCE=
MIAI_OIDC_JWKS_URL=
# DATABASE_URL=postgresql://...       # Azure/Railway Postgres; else file fallback
# MIAI_DATABASE_URL=postgresql://...  # alias for DATABASE_URL
# RENTAL_STORE_PATH=/data/rentals.json
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# Public URL used for OAuth redirect_uri
# Local: http://localhost:3001
# Railway: https://YOUR_SERVICE.up.railway.app
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Staging with mock rails under NODE_ENV=production (BOTH flags required):
# ALLOW_MOCK_RAILS=1
# I_UNDERSTAND_MOCK_RAILS_IN_PROD=1
# Bare embed CORS * (BOTH flags required — prefer an origin allowlist):
# ALLOW_EMBED_ORIGIN_STAR=1
# I_UNDERSTAND_EMBED_ORIGIN_STAR=1
# WEBHOOK_SINK_SECRET=
# Require HMAC v1+timestamp on /api/webhook/sink (reject legacy raw-secret signatures):
# WEBHOOK_SINK_HMAC_ONLY=1
# MCP_SINK_TOKEN=
# Optional: verify Postgres TLS when CA is mounted
# PG_SSL_REJECT_UNAUTHORIZED=1
# PGSSLROOTCERT=/path/to/ca.pem

# Secrets — long random values in staging/production
OAUTH_TOKEN_SECRET=replace-with-long-random-string
OAUTH_STATE_SECRET=
EMBED_KEY_SECRET=
# Embed CORS: comma-separated origins. Bare * needs ALLOW_EMBED_ORIGIN_STAR=1 in production.
EMBED_ALLOWED_ORIGINS=http://localhost:3000
OAUTH_TOKEN_STORE_PATH=
KNOWLEDGE_STORE_PATH=
CATALOG_DIR=

# Optional Upstash Redis REST — shared rate limits + chat sessions when running multiple replicas.
# REDIS_URL=                      # reserved alias; unused in v1
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Google (Calendar + Gmail)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft (M365 Calendar, Teams, Email)
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Slack
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_DEFAULT_CHANNEL=

# Shopify / HubSpot / Xero / QuickBooks / Calendly / Zendesk
SHOPIFY_OAUTH_CLIENT_ID=
SHOPIFY_OAUTH_CLIENT_SECRET=
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
XERO_OAUTH_CLIENT_ID=
XERO_OAUTH_CLIENT_SECRET=
QUICKBOOKS_OAUTH_CLIENT_ID=
QUICKBOOKS_OAUTH_CLIENT_SECRET=
QUICKBOOKS_ENV=sandbox
CALENDLY_OAUTH_CLIENT_ID=
CALENDLY_OAUTH_CLIENT_SECRET=
ZENDESK_OAUTH_CLIENT_ID=
ZENDESK_OAUTH_CLIENT_SECRET=

TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=
HANDOFF_EMAIL_TO=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Consumer Telegram channel. All three enable it end to end:
#  - TELEGRAM_BOT_TOKEN: bot token from @BotFather (Bot API calls).
#  - TELEGRAM_BOT_SECRET: the secret_token registered with setWebhook (verifies inbound
#    webhooks AND signs the account-link setup nonces). Webhook fails closed if unset.
#  - TELEGRAM_BOT_USERNAME: the bot's @username (without @) — used to build the
#    https://t.me/<username>?start=setup_<nonce> "Connect Telegram" deep link.
# Register the webhook once:
#   curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook?url=https://<host>/api/consumer/telegram/webhook&secret_token=$TELEGRAM_BOT_SECRET"
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_SECRET=
TELEGRAM_BOT_USERNAME=

STRIPE_SECRET_KEY=

# Paystack — prepaid token top-ups (MVP: one-time top-ups only, no subscription/rental).
# When PAYSTACK_SECRET_KEY is unset, /api/payments/paystack/init returns 503 and the UI
# falls back to the mock credit (dev/staging only). Set both keys to take real payments.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Settlement currency Paystack bills in (packages are labelled in USD). Default USD;
# set ZAR / NGN / GHS / KES for local-currency markets. Amount is sent in minor units (× 100).
# PAYSTACK_CURRENCY=USD
# Absolute base URL for the Paystack callback/return (else derived from the request origin).
# APP_BASE_URL=https://miaiweb-production.up.railway.app
