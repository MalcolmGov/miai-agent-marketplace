# DATABASE_URL=postgresql://...
# RENTAL_STORE_PATH=/data/rentals.json
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# Public URL used for OAuth redirect_uri
# Local: http://localhost:3001
# Railway: https://YOUR_SERVICE.up.railway.app
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secrets — long random values in staging/production
OAUTH_TOKEN_SECRET=replace-with-long-random-string
OAUTH_STATE_SECRET=
EMBED_KEY_SECRET=
# Embed chat CORS: * (default) or comma-separated origins / https://*.myinstantai.com
EMBED_ALLOWED_ORIGINS=*
OAUTH_TOKEN_STORE_PATH=
KNOWLEDGE_STORE_PATH=
CATALOG_DIR=

# Google (Calendar + Gmail)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

