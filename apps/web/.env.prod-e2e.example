# ============================================================================
# Production-config E2E — environment template
# ============================================================================
# Fill these in on a DEDICATED environment (separate from the live demo/sandbox)
# to mimic full production before the Azure cutover. Every rail is REAL: real
# OIDC, real wallet, real model, Postgres + Redis, fail-closed boot hardening.
#
# After deploying with these values, run the boot gate:
#   node scripts/prod-e2e-gate.mjs https://<this-environment-url>
# It must pass before the E2E journeys. See docs/PROD_E2E.md.
#
# NEVER commit real secrets. This file is a template only.
# ============================================================================

# --- Mode: production, no stubbing -----------------------------------------
NODE_ENV=production
# SANDBOX_MODE must be UNSET (or 0) — any value of 1 alongside real rails fails boot hardening.

# --- Auth: real OIDC (provider-agnostic; any issuer via discovery) ----------
MIAI_AUTH_MODE=oidc
MIAI_OIDC_ISSUER=https://<your-oidc-issuer>          # e.g. Entra / Auth0 / MyInstantAI IdP
MIAI_OIDC_AUDIENCE=<client-or-audience-id>
MIAI_OIDC_JWKS_URL=https://<your-oidc-issuer>/.well-known/jwks.json   # optional if discovery provides it

# --- Wallet: real HTTP gateway ---------------------------------------------
MIAI_WALLET_MODE=http
MIAI_WALLET_API_URL=https://<wallet-gateway-endpoint>   # MyInstantAI gateway, or a contract-compatible stand-in
MIAI_WALLET_API_KEY=<wallet-gateway-secret>

# --- Model: real inference (pick ONE, use a SPEND-CAPPED key) ---------------
MIAI_MODEL_MODE=azure                 # azure | gateway | openai | anthropic
# Azure OpenAI:
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<azure-openai-key>
# ...or model gateway:
# MIAI_MODEL_MODE=gateway
# MIAI_MODEL_GATEWAY_URL=https://<gateway>
# MIAI_MODEL_GATEWAY_KEY=<gateway-key>
# ...or OpenAI directly:
# MIAI_MODEL_MODE=openai
# OPENAI_API_KEY=<spend-capped-openai-key>

# --- Persistence + cache: real, reachable -----------------------------------
DATABASE_URL=postgresql://<user>:<pass>@<host>:5432/<db>?sslmode=require
PG_SSL_REJECT_UNAUTHORIZED=1          # verify managed-Postgres certs
UPSTASH_REDIS_REST_URL=https://<upstash-host>
UPSTASH_REDIS_REST_TOKEN=<upstash-token>

# --- Secrets: strong AND distinct (no shared defaults) ----------------------
OAUTH_TOKEN_SECRET=<32+ char random>
OAUTH_STATE_SECRET=<32+ char random, distinct>
EMBED_KEY_SECRET=<32+ char random, distinct>
MIAI_SESSION_SECRET=<32+ char random, distinct>
WEBHOOK_SINK_SECRET=<32+ char random, distinct>
CRON_SECRET=<32+ char random, distinct>

# --- Bounds (defaults are fine; shown for reference) ------------------------
MIAI_MODEL_TIMEOUT_MS=30000
MIAI_CONNECTOR_TIMEOUT_MS=10000
PG_CONNECT_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=15000

# --- URLs -------------------------------------------------------------------
APP_BASE_URL=https://<this-environment-url>
NEXT_PUBLIC_APP_URL=https://<this-environment-url>
