{
  "name": "@miai/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node server.js 2>/dev/null || node apps/web/server.js 2>/dev/null || next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import ../../scripts/web-test-register.mjs --experimental-strip-types --test test/*.test.mjs",
