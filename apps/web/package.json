  },
  "dependencies": {
    "@miai/agent-protocol": "workspace:^",
    "@miai/connectors": "workspace:^",
    "@miai/presets": "workspace:^",
    "@miai/runtime": "workspace:^",
    "@miai/wallet-adapter": "workspace:^",
    "jose": "^6.2.5",
    "next": "^15.5.24",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
