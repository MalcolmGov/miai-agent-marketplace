# Public URL used for OAuth redirect_uri
# Local: http://localhost:3001
# Railway: https://YOUR_SERVICE.up.railway.app
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MyInstantAI rails (mock until Azure credentials)
MIAI_AUTH_MODE=mock
# Mock workspace roles (comma-separated): owner,admin,agent,readonly,operator
# MIAI_MOCK_ROLES=owner,operator
MIAI_WALLET_MODE=mock
MIAI_MODEL_MODE=mock
# mock | openai | anthropic | gateway
MIAI_WALLET_API_URL=
MIAI_WALLET_API_KEY=
MIAI_MODEL_GATEWAY_URL=
MIAI_MODEL_GATEWAY_KEY=
# ANTHROPIC_API_KEY=              # when MIAI_MODEL_MODE=anthropic
MIAI_OIDC_ISSUER=
MIAI_OIDC_AUDIENCE=
MIAI_OIDC_JWKS_URL=
# B2B Agents auth (separate from consumer Get Started) — see docs/B2B_ONBOARDING.md
# MIAI_AGENTS_AUTH_URL=https://app.myinstantai.com/auth
# NEXT_PUBLIC_MIAI_AGENTS_AUTH_URL=https://app.myinstantai.com/auth
# NEXT_PUBLIC_MIAI_CONSUMER_APP_URL=https://myinstantai.com
# WORKSPACE_ONBOARDING_PATH=          # optional file path for onboarding profiles
# OPENAI_API_KEY=                 # when MIAI_MODEL_MODE=openai (also auto-enables hybrid semantic retrieval)
# RUNTIME_SEMANTIC_RETRIEVAL=auto # auto|1|0|local — hybrid RAG; auto uses OpenAI embeddings when key set
# EMBEDDING_API_KEY=              # optional override (else OPENAI_API_KEY)
# EMBEDDING_BASE_URL=             # OpenAI-compatible /v1 (default api.openai.com/v1)
# EMBEDDING_MODEL=text-embedding-3-small
# DATABASE_URL=postgresql://...   # Azure/Railway Postgres; else file fallback
# MIAI_DATABASE_URL=postgresql://...  # alias for DATABASE_URL
# APPLICATIONINSIGHTS_CONNECTION_STRING=  # Azure App Insights (optional)

# Production hardening — staging demos with mock rails MUST set BOTH:
# ALLOW_MOCK_RAILS=1
# I_UNDERSTAND_MOCK_RAILS_IN_PROD=1
# Production cutover: unset both flags and set real OIDC/wallet/model.
# Allow EMBED_ALLOWED_ORIGINS=* only on staging (BOTH flags; never on customer production):
# ALLOW_EMBED_ORIGIN_STAR=1
# I_UNDERSTAND_EMBED_ORIGIN_STAR=1
# Optional Postgres TLS verify when CA available:
# PG_SSL_REJECT_UNAUTHORIZED=1

# Secrets — use long random values in staging/production (never leave as defaults)
OAUTH_TOKEN_SECRET=replace-with-long-random-string
# Signs OAuth consent state (falls back to OAUTH_TOKEN_SECRET)
OAUTH_STATE_SECRET=
# HMAC for website embed keys (falls back to OAUTH_TOKEN_SECRET)
EMBED_KEY_SECRET=
# Embed chat CORS: comma-list of origins (or https://*.example.com).
# Bare * is refused in production unless dual embed-star flags are set.
EMBED_ALLOWED_ORIGINS=http://localhost:3000
# Wave 4 proof sinks — required in production (NODE_ENV=production)
# WEBHOOK_SINK_SECRET=
# Require HMAC v1+timestamp (reject legacy raw shared-secret in x-miai-signature):
# WEBHOOK_SINK_HMAC_ONLY=1
# MCP_SINK_TOKEN=
# Pitch-deck Admin economics only (never default in production)
# ADMIN_NARRATIVE_ECONOMICS=1
# Railway with volume: /data/oauth-tokens.json
OAUTH_TOKEN_STORE_PATH=
# Railway with volume: /data/knowledge-sources.json
KNOWLEDGE_STORE_PATH=
# Railway with volume: /data/rentals.json
RENTAL_STORE_PATH=
# Custom agent request pipeline
# CUSTOM_REQUESTS_PATH=/data/custom-requests.json
# Railway image default: /app/data/catalog
CATALOG_DIR=

# Optional Upstash Redis REST (free tier) — shared rate limits + chat sessions across replicas.
# Without these, rate limits and sessions stay in-process (single replica only).
# REDIS_URL=                      # reserved alias for a future native client; unused in v1
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Google (Calendar + Gmail email connector)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft (M365 Calendar, Teams, Email-via-Microsoft)
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Slack
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_DEFAULT_CHANNEL=C0123456789

# Shopify
SHOPIFY_OAUTH_CLIENT_ID=
SHOPIFY_OAUTH_CLIENT_SECRET=

# HubSpot
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=

# Xero
XERO_OAUTH_CLIENT_ID=
XERO_OAUTH_CLIENT_SECRET=

# QuickBooks
QUICKBOOKS_OAUTH_CLIENT_ID=
QUICKBOOKS_OAUTH_CLIENT_SECRET=
QUICKBOOKS_ENV=sandbox

# Calendly
CALENDLY_OAUTH_CLIENT_ID=
CALENDLY_OAUTH_CLIENT_SECRET=

# Zendesk
ZENDESK_OAUTH_CLIENT_ID=
ZENDESK_OAUTH_CLIENT_SECRET=

# Teams live handoff targets (after Microsoft OAuth)
TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=

# Email handoff fallback recipient
HANDOFF_EMAIL_TO=

# Optional API-key connectors (or enter in UI)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
STRIPE_SECRET_KEY=
