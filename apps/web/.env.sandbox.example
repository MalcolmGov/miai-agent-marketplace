# =============================================================================
# SANDBOX EVALUATION ENVIRONMENT
# An isolated deployment for a partner's technical team to test / integrate.
# Copy these into your SANDBOX service's env group (a SEPARATE Railway service).
# Never use these values on a production deployment.
# =============================================================================

# Turns on sandbox mode:
#   - mock rails allowed (no dual ALLOW_MOCK_RAILS flags needed)
#   - live connectors are force-stubbed (no real Slack/email/WhatsApp/Stripe sends)
#   - model spend is capped, then falls back to the mock model
#   - agent IP (system prompt, guardrails, evals) is redacted from client responses
#   - a persistent SANDBOX banner is shown on every page
SANDBOX_MODE=1
# Real-provider model turns per process before falling back to the mock model.
SANDBOX_MODEL_TURN_CAP=1000

# --- Isolation: a database SEPARATE from production (own Neon branch / Postgres) ---
DATABASE_URL=postgresql://<user>:<password>@<your-sandbox-db>.neon.tech/neondb?sslmode=require
# (or leave DATABASE_URL unset and mount a writable volume instead)
# DATA_DIR=/data-sandbox

# --- Rails: mock auth + mock wallet — instant demo login, no real money ---
MIAI_AUTH_MODE=mock
MIAI_WALLET_MODE=mock
MIAI_MOCK_ROLES=owner,operator

# --- Model: default MOCK = zero cost (canned responses; good for flow/UI testing).
#     To let them evaluate REAL agent quality, switch to openai with a SEPARATE,
#     provider-capped key (set a hard monthly spend limit on that key). ---
MIAI_MODEL_MODE=mock
# MIAI_MODEL_MODE=openai
# OPENAI_API_KEY=<a sandbox-only key with a hard provider spend limit>
RUNTIME_SEMANTIC_RETRIEVAL=0

# --- Leave payments + outbound channels UNSET so nothing can bill or send ---
# PAYSTACK_SECRET_KEY=      # unset — top-ups use the free mock credit (and the route 503s in sandbox)
# TELEGRAM_BOT_TOKEN=       # unset — the Telegram webhook fails closed (503)
# CRON_SECRET=              # unset — the scheduled brief sweep cannot be triggered
# Do NOT connect real Slack / Gmail / WhatsApp / Stripe tokens in the sandbox workspace.

# --- The sandbox's own URL + fresh secrets (never production's) ---
APP_BASE_URL=https://YOUR-SANDBOX.up.railway.app
NEXT_PUBLIC_APP_URL=https://YOUR-SANDBOX.up.railway.app
OAUTH_TOKEN_SECRET=<a long random string — unique to the sandbox>
EMBED_ALLOWED_ORIGINS=https://YOUR-SANDBOX.up.railway.app

# Teardown: this is a time-boxed evaluation environment. Delete the Railway
# service (and its Neon branch) on the agreed end date.
